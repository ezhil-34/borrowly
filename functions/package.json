{
  "name": "borrowly-functions",
  "version": "1.0.0",
  "description": "Borrowly Firebase Cloud Functions — wraps the Express API gateway",
  "main": "index.js",
  "engines": {
    "node": "22"
  },

  "scripts": {
    "lint": "echo \"No lint configured\" && exit 0",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.5",
    "axios": "^1.6.7",
    "@google/generative-ai": "^0.15.0"
  },
  "private": true
}
